# Store tasks in the current user's application-data directory by default
# Leave unset to use the operating system's per-user PanelTone data directory.

# Store downloaded model files outside the source checkout
# Leave unset to store models beside the per-user PanelTone data directory.

# Keep the local service bound to 127.0.0.1 unless you understand the exposure risk
PANELTONE_COMFYUI_URL=http://127.0.0.1:8188
